// Scene Container plus Dual Shade, so the shade can be split into separate notification and
// Quick Settings panels (MikuUI uses Dual Shade in portrait only, see ShadeModeInteractor).
aconfig_values {
    name: "aconfig-values-miku-cp2a-com.android.systemui-all",
    package: "com.android.systemui",
    srcs: [
        "scene_container_flag_values.textproto",
        "dual_shade_flag_values.textproto",
    ],
}
